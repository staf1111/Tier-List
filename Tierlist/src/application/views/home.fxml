<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1000" prefHeight="650"
            styleClass="root"
            stylesheets="@style.css">

    <left>
        <VBox styleClass="sidebar">

            <Label styleClass="logo" text="TIER&#10;LIST"/>

            <Button text="🏠 Accueil" styleClass="menu-button-active"/>
            <Button text="📋 Mes tier list" styleClass="menu-button"/>
            <Button text="⬇ Importer" styleClass="menu-button"/>
            <Button text="⚙ Paramètres" styleClass="menu-button"/>
            <Button text="? Aide" styleClass="menu-button"/>

        </VBox>
    </left>

    <center>
        <VBox styleClass="main-panel" spacing="20">

            <Label text="RankStation" styleClass="title"/>
            <Label text="Bienvenue, voici vos tier lists" styleClass="subtitle"/>

            <HBox spacing="15">
                <Button text="+ Nouvelle Tier List" styleClass="primary-button"/>
                <Button text="⬇ Importer une Tier List" styleClass="secondary-button"/>
            </HBox>

            <Label text="Vos tier lists du moment" styleClass="section-title"/>

            <GridPane hgap="20" vgap="20" styleClass="grid">
                <Pane styleClass="card" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Pane styleClass="card" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Pane styleClass="card" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                <Pane styleClass="card" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Pane styleClass="card" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Pane styleClass="card" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            </GridPane>

        </VBox>
    </center>

</BorderPane>
